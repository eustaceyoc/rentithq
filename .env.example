# Copy to .env for local development. These values are placeholders, not production secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-insecure-local-key-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://property:property@127.0.0.1:5432/property_dev
DB_CONN_MAX_AGE=0
LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# Production only. Do not put real secrets in this file.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=app.example.com
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_HSTS_SECONDS=0
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Rent It HQ <noreply@example.com>
# FRONTEND_BASE_URL=https://app.example.com

# Local mail prints to the console. These defaults are for password-reset links.
DEFAULT_FROM_EMAIL=Rent It HQ <noreply@example.com>
FRONTEND_BASE_URL=http://127.0.0.1:43123
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Private files. The default is the local filesystem, for development only.
# Production resident documents use a private S3-compatible bucket (Cloudflare R2).
# Set the endpoint from the provider dashboard. Do not hard-code it in Python.
# FILE_STORAGE_BACKEND=filesystem
# FILE_STORAGE_BACKEND=s3
# FILE_STORAGE_S3_ENDPOINT_URL=
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_QUERYSTRING_EXPIRE=300

# Backup bucket. Separate credentials. Django does not read these.
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
