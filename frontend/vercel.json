{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rentithq-api-ainr.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://rentithq-api-ainr.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://rentithq-api-ainr.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://rentithq-api-ainr.onrender.com/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
