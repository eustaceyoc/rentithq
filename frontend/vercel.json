{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://rentithq-api-ainr.onrender.com/api/$1" },
    { "source": "/admin", "destination": "https://rentithq-api-ainr.onrender.com/admin/" },
    { "source": "/admin/(.*)", "destination": "https://rentithq-api-ainr.onrender.com/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://rentithq-api-ainr.onrender.com/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}